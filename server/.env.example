# ─────────────────────────────────────────────────────────────────────────────
# AI Intelligence Hub — server environment (copy to .env and fill in)
#
#   cp .env.example .env
#
# ALL KEYS ARE OPTIONAL. With no keys set the app still runs fully using the
# free/public sources (RSS, arXiv, GitHub, GDELT, Hugging Face). Paid/API
# fetchers (GNews, NewsAPI) and AI summarization simply no-op when their key
# is empty. NEVER commit the real .env (it is git-ignored). NEVER expose these
# values to the React client or place secrets in VITE_* variables.
# ─────────────────────────────────────────────────────────────────────────────

# --- News API keys (leave blank to disable that fetcher gracefully) ---
# GNews.io — primary keyword-based AI news API. https://gnews.io
GNEWS_API_KEY=
# NewsAPI.org — optional supplementary/fallback news API. https://newsapi.org
NEWS_API_KEY=

# --- AI summarization (optional) ---
# When set, powers grounded article summaries/classification via OpenAI.
# When empty, the pipeline uses the built-in extractive summarizer.
AI_API_KEY=
# Base URL for the AI provider (optional; defaults to OpenAI's endpoint).
AI_BASE_URL=
# Model to use for summarization (optional).
AI_MODEL=gpt-4o-mini

# --- Optional: higher GitHub API rate limit for the trending-repos fetcher ---
GITHUB_TOKEN=

# --- Scheduler ---
# How often the ingestion pipeline runs, in minutes (default 15).
NEWS_FETCH_INTERVAL_MINUTES=15

# --- Server ---
PORT=4000
